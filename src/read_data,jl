"""
    despike_snow_height(data::DataFrame, column_name::String="HS_Cor")

Despike snow height data using a one-day moving median filter.

Applies a 1-day rolling median filter, removes values above 2m, and interpolates missing values.

# Arguments
- `data::DataFrame`: Input DataFrame containing snow height data
- `column_name::String`: Name of column containing snow height data (default: "HS_Cor")

# Returns
- `Vector`: Despiked snow height data

# Example
```julia
cleaned_hs = despike_snow_height(slowdata, "HS_Cor")
```
"""
function despike_snow_height(data::DataFrame, column_name::String="HS_Cor")
    if !(column_name in names(data))
        error("Column '$column_name' not found in the DataFrame.")
    end
    
    # Create a copy of the column
    snow_height = copy(data[!, column_name])
    
    # Apply 1-day moving median filter
    # Assuming data is at 1-minute intervals, 1 day = 1440 points
    window_size = 1440  # 1 day at 1-minute resolution
    
    # Calculate rolling median
    n = length(snow_height)
    median_filtered = similar(snow_height)
    
    for i in 1:n
        # Calculate window bounds (centered)
        half_window = div(window_size, 2)
        start_idx = max(1, i - half_window)
        end_idx = min(n, i + half_window)
        
        # Get window data, removing missing values and collecting to array
        window_data = collect(skipmissing(snow_height[start_idx:end_idx]))
        
        # Calculate median if we have data
        if !isempty(window_data)
            median_filtered[i] = median(window_data)
        else
            median_filtered[i] = missing
        end
    end
    
    # Remove values above 2m
    median_filtered = ifelse.(coalesce.(median_filtered .> 2.0, false), missing, median_filtered)
    
    # Interpolate missing values
    median_filtered = _interpolate_linear(median_filtered)
    
    return median_filtered
end

"""
    clean_slowdata(slowdata::DataFrame)

Clean slow data by removing outliers and filtering based on quality checks.

Performs the following operations:
- Selects relevant columns
- Converts wind speed from km/h to m/s
- Applies bounds checks to radiation variables
- Ensures physical consistency (e.g., SWdown > SWup)
- Filters snow height based on quality flag
- Applies despiking to snow height
- Interpolates filtered values

# Arguments
- `slowdata::DataFrame`: Input slow data DataFrame

# Returns
- `DataFrame`: Cleaned slow data

# Example
```julia
cleaned_data = clean_slowdata(slowdata)
```
"""
function clean_slowdata(slowdata::DataFrame)
    # Start with all columns — no whitelist, so wind columns etc. are preserved
    slowdata_cleaned = copy(slowdata)
    
    # Convert WS_FC4 from km/h to m/s
    if "WS_FC4" in names(slowdata_cleaned)
        slowdata_cleaned[!, "WS_FC4"] = slowdata_cleaned[!, "WS_FC4"] ./ 3.6
    end

    # Apply bounds for shortwave radiation (SW: -20 to 1300 W/m²)
    for var in ["SWdown1", "SWdown2", "SWup1", "SWup2"]
        if var in names(slowdata_cleaned)
            slowdata_cleaned[!, var] = ifelse.(
                coalesce.((slowdata_cleaned[!, var] .> 1300) .| (slowdata_cleaned[!, var] .< -20), false),
                missing,
                slowdata_cleaned[!, var]
            )
        end
    end
    
    # Apply bounds for longwave radiation (LW: 10 to 400 W/m²)
    for var in ["LWdown1", "LWdown2", "LWup1", "LWup2"]
        if var in names(slowdata_cleaned)
            slowdata_cleaned[!, var] = ifelse.(
                coalesce.((slowdata_cleaned[!, var] .> 400) .| (slowdata_cleaned[!, var] .< 10), false),
                missing,
                slowdata_cleaned[!, var]
            )
        end
    end
    
    # Check that SWdown > SWup (physically meaningful)
    if "SWdown1" in names(slowdata_cleaned) && "SWup1" in names(slowdata_cleaned)
        slowdata_cleaned[!, "SWdown1"] = ifelse.(
            coalesce.(slowdata_cleaned[!, "SWdown1"] .<= slowdata_cleaned[!, "SWup1"], false),
            missing,
            slowdata_cleaned[!, "SWdown1"]
        )
        slowdata_cleaned[!, "SWdown1"] = _interpolate_linear(slowdata_cleaned[!, "SWdown1"])
    end
    
    if "SWdown2" in names(slowdata_cleaned) && "SWup2" in names(slowdata_cleaned)
        slowdata_cleaned[!, "SWdown2"] = ifelse.(
            coalesce.(slowdata_cleaned[!, "SWdown2"] .<= slowdata_cleaned[!, "SWup2"], false),
            missing,
            slowdata_cleaned[!, "SWdown2"]
        )
        slowdata_cleaned[!, "SWdown2"] = _interpolate_linear(slowdata_cleaned[!, "SWdown2"])
    end
    
    # Apply bounds for surface temperature (210-283 K)
    if "SFTempK" in names(slowdata_cleaned)
        slowdata_cleaned[!, "SFTempK"] = ifelse.(
            coalesce.((slowdata_cleaned[!, "SFTempK"] .> 275) .| (slowdata_cleaned[!, "SFTempK"] .< 210), false),
            missing,
            slowdata_cleaned[!, "SFTempK"]
        )
    end
    
    # Apply bounds for air temperature (>= -60°C)
    if "TA" in names(slowdata_cleaned)
        slowdata_cleaned[!, "TA"] = ifelse.(
            coalesce.(slowdata_cleaned[!, "TA"] .< -55, false),
            missing,
            slowdata_cleaned[!, "TA"]
        )
    end
    
    # Filter snow height based on quality flag and despike
    if "HS_Cor" in names(slowdata_cleaned) && "HS_Qty" in names(slowdata_cleaned)
        slowdata_cleaned[!, "HS_Cor"] = ifelse.(
            coalesce.((slowdata_cleaned[!, "HS_Qty"] .< 152) .| (slowdata_cleaned[!, "HS_Qty"] .> 210), false),
            missing,
            slowdata_cleaned[!, "HS_Cor"]
        )
        
        # Apply despiking
        slowdata_cleaned[!, "HS_Cor"] = despike_snow_height(slowdata_cleaned, "HS_Cor")
        
        # Drop quality column
        select!(slowdata_cleaned, Not("HS_Qty"))
    end

    # Drop columns not needed for analysis
    drop_cols = ["RECORD", "RECORD_1", "BattV_Min", "PTemp_Avg", "PowerSPC", "PowerLIC", "PowerHtr",
                 "rmcutcdate", "rmcutctime", "rmclatitude", "rmclongitude",
                 "Ux_Std", "Uy_Std", "Uz_Std", "Ts_Std",
                 "n_Tot", "csat_warnings",
                 "LI_CO2m_Avg", "LI_H2Om_Avg", "LI_CO2m_Std", "LI_H2Om_Std", "LI_Pres_Std"]
    existing_drop = filter(c -> c in names(slowdata_cleaned), drop_cols)
    if !isempty(existing_drop)
        select!(slowdata_cleaned, Not(existing_drop))
    end

    println("✓ Slow data cleaned")
    println("  Cleaned columns: ", join(names(slowdata_cleaned), ", "))
    
    return slowdata_cleaned
end

# ===== Logger-code masking and H2O reference chain =====

"""
    mask_logger_codes!(df::DataFrame; codes=(-7999.0,)) -> DataFrame

Replace logger "no data" codes (Campbell -7999) by `missing` in every numeric column.
Must run before any unit scaling (otherwise RH -7999 becomes -799900).
"""
function mask_logger_codes!(df::DataFrame; codes=(-7999.0,), tol=1e-6)
    total = 0
    for c in names(df)
        c == "TIMESTAMP" && continue
        nonmissingtype(eltype(df[!, c])) <: Real || continue
        col = df[!, c]
        hits = [!ismissing(v) && any(code -> abs(v - code) <= tol, codes) for v in col]
        n = count(hits)
        n == 0 && continue
        df[!, c] = allowmissing(col)
        df[hits, c] .= missing
        total += n
    end
    println("  masked $total logger-code cells (codes=$(codes))")
    return df
end

"""
    mask_logger_zeros!(df::DataFrame, ta::String, rh::String) -> Int

Rows where TA == 0 and RH == 0 exactly are logger zeros, not measurements: set both to missing.
"""
function mask_logger_zeros!(df::DataFrame, ta::String, rh::String)
    (ta in names(df) && rh in names(df)) || return 0
    df[!, ta] = allowmissing(df[!, ta])
    df[!, rh] = allowmissing(df[!, rh])
    z = coalesce.((df[!, ta] .== 0) .& (df[!, rh] .== 0), false)
    n = count(z)
    if n > 0
        df[z, ta] .= missing
        df[z, rh] .= missing
    end
    println("  masked $n logger-zero rows ($ta/$rh)")
    return n
end

"""
    rh_to_percent!(df::DataFrame, col::String; mode=:auto) -> Bool

Bring an RH column to percent. `:auto` multiplies by 100 when the maximum valid value
is <= 1.5 (fraction), `:fraction` always multiplies, `:percent` never. Returns true if scaled.
"""
function rh_to_percent!(df::DataFrame, col::String; mode::Symbol=:auto)
    col in names(df) || return false
    vals = [Float64(v) for v in df[!, col] if !ismissing(v) && !(v isa AbstractFloat && isnan(v))]
    isempty(vals) && return false
    mx = maximum(vals)
    scale = mode == :fraction || (mode == :auto && mx <= 1.5)
    if scale
        df[!, col] = df[!, col] .* 100
        println("  $col: fraction → percent (×100; max was $(round(mx, digits=3)))")
    else
        println("  $col: kept as percent (max $(round(mx, digits=1)))")
    end
    return scale
end

# Set values outside [lo, hi] to missing; returns the number of masked cells.
function _bound_missing!(df::DataFrame, col::String, lo, hi)
    col in names(df) || return 0
    v = df[!, col]
    bad = coalesce.((v .< lo) .| (v .> hi), false)
    n = count(bad)
    if n > 0
        df[!, col] = allowmissing(v)
        df[bad, col] .= missing
        println("  $col: $n values outside [$lo, $hi] → missing")
    end
    return n
end

"""
    clean_tower_slowdata(slowdata::DataFrame, suffix::String)

Clean slow data for tower sensors (LOWER, UPPER, BOTTOM).
Suffix is the height tag of the sensor's own probe, e.g. "_16m", "_26m", "_5m".

Performs, in this order:
- Masks logger codes (-7999) in all numeric columns and logger zeros (TA==0 && RH==0)
  for every Temp_Xm_Avg/RH_Xm_Avg pair present
- Physical bounds on every Temp_Xm_Avg: -60 to 20 °C
- Every RH_Xm_Avg brought to percent (auto-detects 0–1 fractions), bounded 0–105 %
- Every AP_Xm_Avg bounded 50–110 kPa
- Converts FluxWind columns from km/h to m/s
- Drops diagnostic, redundant, and metadata columns
"""
function clean_tower_slowdata(slowdata::DataFrame, suffix::String)
    cleaned = copy(slowdata)
    println("Cleaning tower slow data (suffix=$suffix): $(nrow(cleaned)) rows")

    mask_logger_codes!(cleaned)

    heights = String[]
    for c in names(cleaned)
        m = match(r"^Temp_(\d+m)_Avg$", c)
        m === nothing || push!(heights, m.captures[1])
    end
    for h in heights
        mask_logger_zeros!(cleaned, "Temp_$(h)_Avg", "RH_$(h)_Avg")
        _bound_missing!(cleaned, "Temp_$(h)_Avg", -60, 20)
    end

    for c in names(cleaned)
        occursin(r"^RH_\d+m_Avg$", c) || continue
        rh_to_percent!(cleaned, c)
        _bound_missing!(cleaned, c, 0, 105)
    end

    for c in names(cleaned)
        occursin(r"^AP_\d+m_Avg$", c) || continue
        _bound_missing!(cleaned, c, 50, 110)
    end

    # Convert FluxWind columns from km/h to m/s (only LOWER has these)
    wind_kmh_patterns = ["WindMin_", "WindMean_", "WindMax_", "FC_Wind_"]
    for c in names(cleaned)
        if any(p -> startswith(c, p), wind_kmh_patterns)
            cleaned[!, c] = cleaned[!, c] ./ 3.6
        end
    end

    # Drop unwanted columns
    drop_cols = [
        "RECORD", "BattV_L_Min", "BattV_U_Min", "BattV_B_Min",
        "PTemp_L_Avg", "PTemp_U_Avg", "PTemp_B_Avg",
        "LI_CO2m$(suffix)_Avg", "LI_diag$(suffix)_Avg",
        "LI_CO2m$(suffix)_Std", "LI_H2Om$(suffix)_Std",
        "LI_Pres$(suffix)_Std", "LI_diag$(suffix)_Std",
        "wnd_dir_compass$(suffix)", "wnd_dir_csat3$(suffix)",
        "rslt_wnd_spd$(suffix)", "std_wnd_dir$(suffix)",
        "csat_warnings$(suffix)",
        "delT_f_Tot$(suffix)", "sigl_f_Tot$(suffix)",
        "amph_f_Tot$(suffix)", "ampl_f_Tot$(suffix)",
        "li_chopper$(suffix)", "li_detector$(suffix)",
        "li_pll$(suffix)", "li_sync$(suffix)",
    ]
    existing_drop = filter(c -> c in names(cleaned), drop_cols)
    if !isempty(existing_drop)
        select!(cleaned, Not(existing_drop))
    end

    println("✓ Tower slow data cleaned (suffix=$suffix)")
    println("  Cleaned columns: ", join(names(cleaned), ", "))

    return cleaned
end

# ----- H2O reference chain ---------------------------------------------------

"""
Default TA/RH reference sources for the LI-7500 H2O correction, in priority order.
Each entry: (sensor whose slow files are read, suffix passed to clean_tower_slowdata,
TA column, RH column). Minute by minute the first entry with valid TA and RH wins.
Override per run with ENV["PEA_REF_CHAIN_<SENSOR>"] = "SENSOR:suffix:TAcol:RHcol,...".
"""
const H2O_REF_CHAIN = Dict(
    "LOWER" => [
        (sensor="LOWER", suffix="_16m", ta="Temp_16m_Avg", rh="RH_16m_Avg"),   # own 16 m probe
        (sensor="UPPER", suffix="_26m", ta="Temp_26m_Avg", rh="RH_26m_Avg"),   # UPPER 26 m probe (absolute humidity transfer)
        (sensor="LOWER", suffix="_16m", ta="Temp_10m_Avg", rh="RH_10m_Avg"),   # 10 m probe on the LOWER logger
    ],
    "UPPER" => [
        (sensor="UPPER", suffix="_26m", ta="Temp_26m_Avg", rh="RH_26m_Avg"),   # own 26 m probe
        (sensor="LOWER", suffix="_16m", ta="Temp_10m_Avg", rh="RH_10m_Avg"),   # 10 m probe on the LOWER logger
    ],
)

"""
    parse_ref_chain(spec::AbstractString)

Parse "SENSOR:suffix:TAcol:RHcol,SENSOR:suffix:TAcol:RHcol,..." into chain entries.
"""
function parse_ref_chain(spec::AbstractString)
    out = NamedTuple{(:sensor, :suffix, :ta, :rh), NTuple{4, String}}[]
    for item in split(spec, ',')
        p = split(strip(item), ':')
        length(p) == 4 || error("Bad reference chain item '$item' (expected SENSOR:suffix:TAcol:RHcol)")
        push!(out, (sensor=String(p[1]), suffix=String(p[2]), ta=String(p[3]), rh=String(p[4])))
    end
    return out
end

"""
    load_cleaned_slow!(cache, sensor, suffix; input_base) -> DataFrame

Read and clean the slow data of `sensor` once; later calls return the cached frame.
"""
function load_cleaned_slow!(cache::Dict{String, DataFrame}, sensor::String, suffix::String; input_base::String)
    haskey(cache, sensor) && return cache[sensor]
    println("Reading slow data for $sensor ...")
    raw = read_slow_data(base_path=input_base, sensor=sensor)
    if nrow(raw) == 0
        @warn "No slow data found for $sensor under $input_base"
        cache[sensor] = DataFrame(TIMESTAMP=DateTime[])
        return cache[sensor]
    end
    unique!(raw, :TIMESTAMP)
    sort!(raw, :TIMESTAMP)
    cache[sensor] = clean_tower_slowdata(raw, suffix)
    println("  $(nrow(cache[sensor])) slow records for $sensor")
    return cache[sensor]
end

"""
    build_reference_chain(chain; input_base, cache=Dict()) -> DataFrame

Build the minute-by-minute TA/RH reference for the H2O correction from an ordered
list of sources (see `H2O_REF_CHAIN`). Returns a DataFrame on a regular 1-min grid
spanning all sources with columns `TIMESTAMP`, `TA_ref` (°C), `RH_ref` (%), and
`REF_SRC` (1-based index of the chain entry used; 0 = no reference; 9 = interpolated).
"""
function build_reference_chain(chain; input_base::String, cache::Dict{String, DataFrame}=Dict{String, DataFrame}())
    sources = [load_cleaned_slow!(cache, e.sensor, e.suffix; input_base=input_base) for e in chain]

    tmin = nothing; tmax = nothing
    for df in sources
        nrow(df) == 0 && continue
        a, b = extrema(df.TIMESTAMP)
        tmin = tmin === nothing ? a : min(tmin, a)
        tmax = tmax === nothing ? b : max(tmax, b)
    end
    if tmin === nothing
        @warn "No slow data found for any reference source"
        return DataFrame(TIMESTAMP=DateTime[], TA_ref=Float64[], RH_ref=Float64[], REF_SRC=Int[])
    end

    grid = collect(floor(tmin, Minute):Minute(1):ceil(tmax, Minute))
    n = length(grid)
    ta = fill(NaN, n); rh = fill(NaN, n); src = zeros(Int, n)
    index = Dict(t => i for (i, t) in enumerate(grid))

    println("Building H2O reference chain ($(length(chain)) sources):")
    for (k, (e, df)) in enumerate(zip(chain, sources))
        if !(e.ta in names(df) && e.rh in names(df))
            println("  [$k] $(e.sensor) $(e.ta)/$(e.rh): columns not available — skipped")
            continue
        end
        filled = 0
        for (t, a, b) in zip(df.TIMESTAMP, df[!, e.ta], df[!, e.rh])
            (ismissing(a) || ismissing(b)) && continue
            fa = Float64(a); fb = Float64(b)
            (isnan(fa) || isnan(fb)) && continue
            i = get(index, floor(t, Minute), 0)
            i == 0 && continue
            src[i] == 0 || continue
            ta[i] = fa; rh[i] = fb; src[i] = k; filled += 1
        end
        println("  [$k] $(e.sensor) $(e.ta)/$(e.rh): $filled minutes")
    end
    println("  grid $(grid[1]) → $(grid[end]): $n minutes, $(count(==(0), src)) without reference")
    return DataFrame(TIMESTAMP=grid, TA_ref=ta, RH_ref=rh, REF_SRC=src)
end

"""
    interpolate_short_gaps!(ref::DataFrame; max_gap_minutes=10) -> Int

Linearly fill reference gaps of at most `max_gap_minutes` bounded by valid minutes
on both sides; filled minutes get `REF_SRC = 9`.
"""
function interpolate_short_gaps!(ref::DataFrame; max_gap_minutes::Int=10)
    n = nrow(ref)
    ta = ref.TA_ref; rh = ref.RH_ref; src = ref.REF_SRC
    filled = 0
    i = 1
    while i <= n
        if src[i] == 0
            j = i
            while j <= n && src[j] == 0
                j += 1
            end
            gap = j - i
            if i > 1 && j <= n && gap <= max_gap_minutes
                for m in i:(j - 1)
                    α = (m - (i - 1)) / (j - (i - 1))
                    ta[m] = ta[i - 1] + α * (ta[j] - ta[i - 1])
                    rh[m] = rh[i - 1] + α * (rh[j] - rh[i - 1])
                    src[m] = 9
                end
                filled += gap
            end
            i = j
        else
            i += 1
        end
    end
    println("  interpolated $filled reference minutes (gaps ≤ $max_gap_minutes min)")
    return filled
end

# Helper function for linear interpolation
function _interpolate_linear(data::AbstractVector)
    result = copy(data)
    n = length(result)
    
    # Find first non-missing value
    first_valid = findfirst(!ismissing, result)
    if isnothing(first_valid)
        return result  # All missing
    end
    
    # Find last non-missing value
    last_valid = findlast(!ismissing, result)
    if isnothing(last_valid) || first_valid == last_valid
        return result  # Only one valid value or none
    end
    
    # Interpolate between valid points
    i = first_valid
    while i <= last_valid
        if ismissing(result[i])
            # Find the previous non-missing value
            j = i - 1
            while j >= first_valid && ismissing(result[j])
                j -= 1
            end
            prev_idx = j
            
            # Find next non-missing value
            k = i + 1
            while k <= last_valid && ismissing(result[k])
                k += 1
            end
            next_idx = k
            
            # Linear interpolation
            if prev_idx >= first_valid && next_idx <= last_valid
                y0 = result[prev_idx]
                y1 = result[next_idx]
                span = next_idx - prev_idx
                
                for m in (prev_idx+1):(next_idx-1)
                    if ismissing(result[m])
                        alpha = (m - prev_idx) / span
                        result[m] = y0 + alpha * (y1 - y0)
                    end
                end
                
                i = next_idx
            else
                i += 1
            end
        else
            i += 1
        end
    end
    
    return result
end
